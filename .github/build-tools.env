# CI のテストとリリースのビルドが、Nix を使わずに入れるツールの版とチェックサム（DEC-SYS-015）。
# just と XcodeGen の版は flake.lock と一致させる。ずれると just lint-build-tools が失敗する。
# チェックサムは、上流の GitHub リリースの配布物の SHA-256 である。
JUST_VERSION=1.59.0
JUST_SHA256=6574cea774ed4cae12e24b6aa11857de33e80dab4667cf628fd5840df96a2a9d
XCODEGEN_VERSION=2.44.1
XCODEGEN_SHA256=a2e905fb68446e9bb4008cdfe2e13e3f176d0cbcca828b71770f8e53fca91b73
# Sparkle はアプリに組み込む版とそろえる（DEC-SYS-019）。tar.xz の配布物を使う。
SPARKLE_VERSION=2.10.1
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
