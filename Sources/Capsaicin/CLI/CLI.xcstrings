{
  "sourceLanguage": "ja",
  "strings": {
    "outcome.started": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止をオンにしました。"
          }
        }
      }
    },
    "outcome.alreadyBlocking": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止はすでにオンです。指定した条件は適用していません。"
          }
        }
      }
    },
    "outcome.released": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止をオフにしました。"
          }
        }
      }
    },
    "outcome.alreadyStopped": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止はすでにオフです。"
          }
        }
      }
    },
    "outcome.rejected": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止をオンにできません。%@"
          }
        }
      }
    },
    "outcome.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でCLIからの操作が許可されていません。"
          }
        }
      }
    },
    "error.version": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとコマンドの通信形式のバージョンが異なります。"
          }
        }
      }
    },
    "error.connection": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとの通信を完了できませんでした。要求を送信した後に通信が失敗した場合は、操作が実行済みのことがあります。"
          }
        }
      }
    },
    "error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとの通信が制限時間内に完了しませんでした。要求を送信した後に通信が失敗した場合は、操作が実行済みのことがあります。"
          }
        }
      }
    },
    "error.launch": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドを含むアプリを起動できませんでした。"
          }
        }
      }
    },
    "error.protocol": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとの通信で正しい応答を受け取れませんでした。"
          }
        }
      }
    },
    "error.authentication": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとの安全な接続を確認できませんでした。"
          }
        }
      }
    },
    "error.usage": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使い方: capsaicin on [--for <時間> | --until <時刻>] / off / status"
          }
        }
      }
    },
    "argument.missingCommand": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブコマンドを指定してください。"
          }
        }
      }
    },
    "argument.unknownCommand": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は不明なサブコマンドです。"
