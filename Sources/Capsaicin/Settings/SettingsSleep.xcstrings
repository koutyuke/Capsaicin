    "lidClose.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While sleep prevention is on, options other than “System sleep” also prevent sleep from the Apple menu; macOS cannot control these separately. They require the helper and approval in System Settings. With “Set brightness to 0”, closing the display only dims it and does not lock your Mac; if automatic display sleep is allowed, the display may later turn off and your Mac may lock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinがオンの間は、「システムスリープ」以外なら、ディスプレイを閉じても、アップルメニューの「スリープ」などを選んでもスリープしません。OSの仕組み上、この2つは個別に設定できず、ヘルパーとシステム設定での許可が必要です。「明るさを0」では、閉じている間も画面は暗いだけでロックされません。「ディスプレイを自動でオフにしない」がオフなら、時間が来るとディスプレイがオフになり、ロックされることがあります。"
          }
        }
      }
    },
    "lidClose.keepOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay on"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンのまま"
          }
        }
      }
    },
    "lidClose.label" : {
