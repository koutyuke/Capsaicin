    "time.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep prevention turns off automatically at this time. If this time has already passed when turned on, it turns off at this time the next day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時刻になると自動でスリープ防止がオフになります。オンにした時点でこの時刻を過ぎている場合は、翌日のこの時刻にオフになります。"
          }
        }
      }
    },
