    "helperRequiresApproval" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setting cannot be applied because the helper is awaiting approval. Allow Capsaicin in System Settings > General > Login Items & Extensions; you can open it from Helper settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが承認待ちのため、この設定を適用できません。システム設定の「一般 > ログイン項目と機能拡張」でCapsaicinの項目を許可してください。設定の「ヘルパー」から開けます。"
          }
        }
      }
    },
