{
  "sourceLanguage" : "ja",
  "strings" : {
    "display.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定時間操作がないときの画面の消灯とスクリーンセーバーを防ぎます。オフにすると、システム設定どおりに画面が消えます。"
          }
        }
      }
    },
    "display.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の自動消灯とスクリーンセーバー"
          }
        }
      }
    },
    "group.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープの種類"
          }
        }
      }
    },
    "helperNotReady" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが正しくインストールされていないため、スリープを防止できません。設定の「ヘルパー」で修復してください。"
          }
        }
      }
    },
    "helperNotReady.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、ヘルパーを使用できません"
          }
        }
      }
    },
    "lidDisplay.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープとディスプレイを閉じたときのスリープを防止しているときだけ使えます。「消灯」にすると、Macを動かしたまま画面を消して消費電力を抑えます。"
          }
        }
      }
    },
    "lidDisplay.keepOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つけたまま"
          }
        }
      }
    },
    "lidDisplay.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じたときの画面"
          }
        }
      }
    },
    "lidDisplay.turnOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消灯"
          }
        }
      }
    },
    "manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップルメニューなどの手動スリープを防ぎます。利用には管理者のパスワードによるヘルパーのインストールが必要です。"
          }
        }
      }
    },
    "manual.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープ"
          }
        }
      }
    },
    "manualAndLid.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップルメニューなどの手動スリープと、ディスプレイを閉じたときのスリープを防ぎます。macOSの仕様上、2つは個別に防止できません。利用には管理者のパスワードによるヘルパーのインストールが必要です。"
          }
        }
      }
    },
    "manualAndLid.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープとディスプレイを閉じたときのスリープ"
          }
        }
      }
    },
    "title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止するスリープ"
