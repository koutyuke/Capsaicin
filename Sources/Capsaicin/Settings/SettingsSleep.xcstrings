{
  "sourceLanguage" : "ja",
  "strings" : {
    "display.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定時間操作がないときの画面の消灯を防ぎます。オンにすると、Mac全体の自動スリープも防ぎます。"
          }
        }
      }
    },
    "display.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の自動消灯"
          }
        }
      }
    },
    "group.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープの種類"
          }
        }
      }
    },
    "helperNotReady" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが正しくインストールされていないため、スリープを防止できません。設定の「ヘルパー」で修復してください。"
          }
        }
      }
    },
    "helperNotReady.a11y" : {
      "extractionState" : "manual",
