    "brightnessUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは画面の明るさを変更できないため、ディスプレイを閉じても画面はオンのままになります。"
          }
        }
      }
    },
    "brightnessUnavailable.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、画面の明るさを変更できません"
          }
        }
      }
    },
    "display.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinがオンの間、操作がない場合でもスクリーンセーバーの起動やディスプレイの消灯を防ぎます。この設定をオフにしてディスプレイが消灯しても、Mac本体はスリープしません。"
          }
        }
      }
    },
    "display.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを自動でオフにしない"
          }
        }
      }
    },
    "helperNotReady" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが正しくインストールされていないため、この設定を適用できません。設定の「ヘルパー」で修復してください。"
          }
        }
      }
    },
    "helperNotReady.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、ヘルパーを使用できません"
          }
        }
      }
    },
    "hours" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
