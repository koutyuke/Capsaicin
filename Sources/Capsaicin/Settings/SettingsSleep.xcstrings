    "manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While sleep prevention is on, prevents your Mac from going to sleep even when you choose Sleep from the Apple menu. Requires the helper and approval in System Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinがオンの間は、アップルメニューの「スリープ」などを選んでもスリープしません。ヘルパーとシステム設定での許可が必要です。"
          }
        }
      }
    },
