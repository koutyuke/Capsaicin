    },
    "lidClose.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スリープ」以外を選ぶと、Capsaicinがオンの間は、ディスプレイを閉じても、アップルメニューの「スリープ」などを選んでも、Macはスリープしません。使うには、管理者パスワードでヘルパーをインストールする必要があります。「明るさを0」では、閉じている間は画面を暗くするだけでロックしないため、ディスプレイを開くとすぐに操作できます。「ディスプレイを自動でオフにしない」をオフにしていると、時間が経ってディスプレイがオフになり、ロックされることがあります。"
          }
        }
      }
    },
    "lidClose.keepOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンのまま"
