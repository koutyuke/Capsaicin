    "behavior.group.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep & Display"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープとディスプレイ"
          }
        }
      }
    },
    "brightnessUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because display brightness cannot be changed on this Mac, the display will stay on when closed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは画面の明るさを変更できないため、ディスプレイを閉じても画面はオンのままになります。"
          }
        }
      }
    },
    "brightnessUnavailable.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Cannot change display brightness"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、画面の明るさを変更できません"
          }
        }
      }
    },
    "display.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While sleep prevention is on, prevents the screen saver from starting and the display from turning off, even when inactive. If you turn off this setting and the display turns off, your Mac itself will not go to sleep."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ防止がオンの間、操作がない場合でもスクリーンセーバーの起動やディスプレイの消灯を防ぎます。この設定をオフにしてディスプレイが消灯しても、Mac本体はスリープされません。"
          }
        }
      }
    },
    "display.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent display from turning off automatically"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを自動でオフにしない"
          }
        }
      }
    },
    "helperNotReady" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because the helper is not properly installed, this setting cannot be applied. Repair it in Helper settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが正しくインストールされていないため、この設定を適用できません。設定の「ヘルパー」で修復してください。"
          }
        }
      }
    },
    "helperNotReady.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Helper is not available"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、ヘルパーを使用できません"
          }
        }
      }
    },
    "hours" : {
      "extractionState" : "manual",
