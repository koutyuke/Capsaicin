        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、ヘルパーを使用できません"
          }
        }
      }
    },
    "idle.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定時間操作がないときのMac全体のスリープを防ぎます。画面の消灯は「画面の自動消灯」で個別に設定できます。"
          }
        }
      }
    },
    "idle.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スリープ"
          }
        }
      }
    },
    "implied.byDisplay" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「画面の自動消灯」がオンのため、このスリープも防止されます。"
          }
        }
      }
    },
    "implied.byManual" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「手動スリープ」がオンのため、このスリープも防止されます。"
          }
        }
      }
    },
    "implied.byManualAndLid" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「手動スリープとディスプレイを閉じたときのスリープ」がオンのため、このスリープも防止されます。"
          }
        }
      }
    },
    "lid.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacBookのディスプレイを閉じてもスリープさせず、処理を継続させます。"
          }
        }
      }
    },
    "lid.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを閉じたときのスリープ"
          }
        }
      }
    },
    "lidDisplayOff.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを閉じたときのスリープを防止しているときだけ使えます。画面を消灯して消費電力を抑えながら、Macは動き続けます。"
          }
        }
      }
    },
    "lidDisplayOff.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じたときに画面を消灯"
          }
        }
      }
    },
    "manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップルメニューなどの手動スリープに加え、ディスプレイを閉じたときのスリープと自動スリープも防ぎますが、画面の自動消灯は防ぎません。利用には管理者のパスワードによるヘルパーのインストールが必要です。"
          }
        }
      }
    },
    "manual.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープ"
          }
        }
      }
    },
    "manualAndLid.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープとディスプレイを閉じたときのスリープに加え、自動スリープも防ぎますが、画面の自動消灯は防ぎません。macOSの仕様上、手動スリープとディスプレイを閉じたときのスリープは個別に防止できず、利用にはヘルパーのインストールが必要です。"
          }
        }
      }
    },
    "manualAndLid.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動スリープとディスプレイを閉じたときのスリープ"
          }
        }
      }
    },
    "title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止するスリープ"
          }
        }
      }
    }
  },
  "version" : "1.0"
