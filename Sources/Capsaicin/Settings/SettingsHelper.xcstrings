    "intro.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small companion program that runs with administrator privileges. It switches system-wide sleep settings that regular sleep prevention cannot control."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者権限で動作する小さな補助プログラムです。通常のスリープ防止では制御できない、システム全体のスリープ設定を切り替えるために使用します。"
          }
        }
      }
    },
