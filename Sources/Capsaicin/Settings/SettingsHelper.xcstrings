    "error.settingRollback.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setting has been reverted to its previous state because the change could not be applied to Capsaicin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinの動作に反映できなかったため、設定を変更前の状態に戻しました。"
          }
