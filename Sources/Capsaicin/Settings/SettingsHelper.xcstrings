          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーを削除できませんでした"
          }
        }
      }
    },
    "error.helperRetry.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again. If the problem continues, restart your Mac or reinstall Capsaicin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度試してください。解決しない場合は、Macを再起動するか、Capsaicinを入れ直してください。"
          }
        }
      }
    },
    "error.helperTranslocated.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicin is running from a temporary App Translocation location. Move it to the Applications folder and reopen it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Translocationの一時的な場所で動いているため、「アプリケーション」フォルダーに移して開き直してください。"
          }
        }
      }
    },
    "error.helperTranslocated.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not install helper from this location"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所からはヘルパーをインストールできません"
          }
        }
      }
    },
    "error.settingRollback.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setting has been reverted to its previous state because the change could not be applied to Capsaicin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinの動作に反映できなかったため、設定を変更前の状態に戻しました。"
          }
        }
      }
    },
    "error.settingRollback.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
