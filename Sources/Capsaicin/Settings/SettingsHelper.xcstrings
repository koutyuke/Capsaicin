    "helperInstall.lidClose.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To keep your Mac awake when the display is closed, install the helper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを閉じてもスリープさせないには、ヘルパーのインストールが必要です"
          }
        }
      }
    },
    "helperInstall.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registers a small program that switches sleep settings, a configuration allowing its execution, and an item that restores sleep settings on Mac startup. Your administrator password is required once. You can remove it anytime from Helper settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ設定を切り替える小さなプログラム、その実行を許可する設定、Mac起動時にスリープ設定を元に戻す項目をシステムに登録します。管理者のパスワードが1回必要です。設定の「ヘルパー」から削除できます。"
          }
        }
      }
    },
    "helperInstall.setting.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use “Prevent sleep from Apple menu”, install the helper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「メニューから選んでもスリープさせない」を使うにはヘルパーのインストールが必要です"
          }
        }
      }
    },
    "helperInstall.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the helper?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーをインストールしますか？"
          }
        }
      }
    },
    "helperRemove.button" : {
