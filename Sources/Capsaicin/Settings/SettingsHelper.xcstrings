    "helperRemove.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After removal, your Mac goes to sleep when you close the display or choose Sleep from the Apple menu, even while sleep prevention is on. Your administrator password is required to remove it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると、Capsaicinがオンの間でも、ディスプレイを閉じたときやメニューから選んだときにMacがスリープするようになります。削除には管理者のパスワードが必要です。"
          }
        }
      }
    },
    "helperRemove.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the helper?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーを削除しますか？"
          }
        }
      }
    },
