    "helperInstall.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The helper runs a small program as root only to switch sleep settings and restore them when your Mac starts up. You can remove the helper in Helper settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープを切り替えるだけの小さなプログラムをrootで動かし、Macの起動時にスリープ設定を元に戻します。設定の「ヘルパー」から削除できます。"
          }
        }
      }
    },
    "helperInstall.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the helper?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーをインストールしますか？"
          }
        }
      }
    },
    "helperRemove.button" : {
      "extractionState" : "manual",
