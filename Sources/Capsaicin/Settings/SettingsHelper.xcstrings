          }
        }
      }
    },
    "helperInstall.confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
