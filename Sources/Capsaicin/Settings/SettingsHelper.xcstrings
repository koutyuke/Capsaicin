    "status.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs three components on your system: a small program that prevents sleep when closing the display or selecting sleep from the menu, a setting allowing it to run without a password, and an item that safely restores sleep settings when Mac starts up."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューから選んだときやディスプレイを閉じたときのスリープを止める小さなプログラム、パスワードなしでの実行を許可する設定、Mac起動時にスリープ設定を安全に戻す項目の3つをシステムにインストールします。"
          }
        }
      }
    },
