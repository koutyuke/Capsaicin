          }
        }
      }
    },
    "error.helperInstall.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved settings have not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した設定は変えていません。"
          }
        }
      }
    },
    "error.helperInstall.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not install helper"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーをインストールできませんでした"
          }
        }
      }
    },
    "error.helperRemove.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The helper could not be unregistered. Your saved settings have not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーの登録を解除できませんでした。保存した設定は変えていません。"
          }
        }
      }
    },
    "error.helperRemove.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not remove helper"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーを削除できませんでした"
          }
        }
      }
    },
    "error.helperRestore.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicin could not restore the sleep setting it changed, so the helper was not removed. Your saved settings have not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinが変更したスリープ設定を元に戻せないため、ヘルパーを削除しませんでした。保存した設定は変えていません。"
          }
        }
      }
    },
    "error.helperRestore.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not restore sleep settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ設定を元に戻せませんでした"
          }
        }
      }
    },
    "error.helperTranslocated.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicin is running from a temporary App Translocation location. Move it to the Applications folder and reopen it; your saved settings have not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CapsaicinがApp Translocationの一時的な場所で動いているため、「アプリケーション」フォルダーに移して開き直してください。保存した設定は変えていません。"
          }
        }
      }
    },
    "error.helperTranslocated.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not install helper from this location"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所からはヘルパーをインストールできません"
          }
        }
      }
    },
    "error.settingRollback.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setting has been reverted to its previous state because the change could not be applied to Capsaicin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicinの動作に反映できなかったため、設定を変更前の状態に戻しました。"
          }
        }
      }
    },
    "error.settingRollback.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not change setting"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を変更できませんでした"
          }
        }
      }
    },
    "helperInstall.button" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
