    "backgroundDisabled.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Background item is disabled"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、バックグラウンド項目が無効です"
          }
        }
      }
    },
    "backgroundDisabled.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsaicin's background item is disabled in macOS System Settings, so the app cannot automatically restart after a crash. Allow it in Login Items & Extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのシステム設定でCapsaicinのバックグラウンド項目が無効になっているため、クラッシュ時に自動で再起動することができません。「ログイン項目と機能拡張」で許可してください。"
          }
        }
      }
    },
    "backgroundDisabled.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background item is disabled"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目が無効です"
          }
        }
      }
    },
    "dockIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show icon in Dock"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockにアイコンを表示"
          }
        }
      }
    },
    "help.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help for %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の説明"
          }
        }
      }
    },
    "hud.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays a brief one-line overlay at the bottom of the screen showing status changes and warnings. Appears when using the menu or hotkey, and when turned off automatically by timer, scheduled time, or low battery. Does not appear when controlled from the CLI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替え結果や警告などを1行で知らせる小さな表示を、画面の下部に短時間出します。メニューやホットキーでの操作時、タイマー・指定時刻・バッテリー残量で自動オフになったときにも表示されます。CLIによる操作では表示されません。"
          }
        }
      }
    },
    "hud.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show HUD when switching"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替え時にHUDを表示"
          }
        }
      }
    },
    "launchAtLogin.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open at login"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時に起動"
          }
        }
      }
    },
    "menuBarIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show icon in menu bar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにアイコンを表示"
          }
        }
      }
    },
    "restartUnavailable.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to register or launch the background item. You can continue using the app, but if it crashes, you will need to open it manually."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目の登録または起動に失敗しました。アプリはこのまま使えますが、クラッシュした場合は手動で起動してください。"
          }
        }
      }
    },
    "restartUnavailable.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not automatically restart after crash"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ時に自動再起動できませんでした"
          }
        }
      }
    },
    "resume.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep prevention resumes with its timer or scheduled time only if it was active before the app closed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの終了前にスリープ防止中だった場合のみ、タイマーや指定時刻を引き継いでスリープ防止が再開されます。"
          }
        }
      }
    },
    "resume.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume sleep prevention"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ防止の再開"
          }
        }
      }
    },
