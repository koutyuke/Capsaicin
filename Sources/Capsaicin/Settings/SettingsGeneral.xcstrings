{
  "sourceLanguage" : "ja",
  "strings" : {
    "backgroundDisabled.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、バックグラウンド項目が無効です"
          }
        }
      }
    },
    "backgroundDisabled.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのシステム設定でCapsaicinのバックグラウンド項目が無効になっているため、クラッシュ時に自動で再起動されません。「ログイン項目と機能拡張」で許可してください。"
          }
        }
      }
    },
    "backgroundDisabled.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目が無効です"
          }
        }
      }
    },
    "dockIcon.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、DockとCommand-Tabのアプリの切り替えにCapsaicinが表示されます。Dockのアイコンをクリックすると設定画面が開きます。"
          }
        }
      }
    },
    "dockIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockにアイコンを表示"
          }
        }
      }
    },
    "help.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の説明"
          }
        }
      }
    },
    "hud.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューやホットキーで切り替えたときや、自動でオフになったときに画面下部に表示します。CLIで操作したときは表示しません。"
          }
        }
      }
    },
    "hud.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替え時にHUDを表示"
          }
        }
      }
    },
    "launchAtLogin.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時に起動"
          }
        }
      }
    },
    "menuBarIcon.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにしてもCapsaicinは動き続けます。設定を開くにはFinderやSpotlightからCapsaicinをもう一度開き、終了するには設定画面の左下にある「Capsaicinを終了」を押します。"
          }
        }
      }
    },
    "menuBarIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにアイコンを表示"
          }
        }
      }
    },
    "restartUnavailable.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目の登録または起動に失敗しました。アプリはこのまま使えますが、クラッシュした場合は手動で起動してください。"
          }
        }
      }
    },
    "restartUnavailable.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ時に自動再起動できません"
          }
        }
      }
    },
    "resume.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アプリ再起動時のみ」はクラッシュ後の自動再起動を指します。「アプリとMacの再起動時」では、Macの再起動やログアウト後のログイン時にもスリープ防止を再開します。"
          }
        }
      }
    },
    "resume.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動後のスリープ防止"
          }
        }
      }
    },
    "resume.option.app" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ再起動時のみ"
          }
        }
      }
    },
    "resume.option.appAndMac" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとMacの再起動時"
          }
        }
      }
    },
    "resume.option.never" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再開しない"
          }
        }
      }
    },
    "title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般"
          }
        }
      }
    }
  },
  "version" : "1.0"
