      }
    },
    "backgroundDisabled.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告、バックグラウンド項目が無効です"
          }
        }
      }
    },
    "backgroundDisabled.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのシステム設定でCapsaicinのバックグラウンド項目が無効になっているため、クラッシュ時に自動で再起動することができません。「ログイン項目と機能拡張」で許可してください。"
          }
        }
      }
    },
    "backgroundDisabled.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目が無効です"
          }
        }
      }
    },
    "dockIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockにアイコンを表示"
          }
        }
      }
    },
    "help.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の説明"
          }
        }
      }
    },
    "hud.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替え結果や警告などを1行で知らせる小さな表示を、画面の下部に短時間出します。メニューやホットキーでの操作時、タイマー・指定時刻・バッテリー残量で自動オフになったときにも表示されます。CLIによる操作では表示されません。"
          }
        }
      }
    },
    "hud.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替え時にHUDを表示"
          }
        }
      }
    },
    "launchAtLogin.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時に起動"
          }
        }
      }
    },
    "menuBarIcon.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにアイコンを表示"
          }
        }
      }
    },
    "restartUnavailable.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目の登録または起動に失敗しました。アプリはこのまま使えますが、クラッシュした場合は手動で起動してください。"
          }
        }
      }
    },
    "restartUnavailable.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ時に自動再起動できませんでした"
          }
        }
      }
    },
    "resume.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの終了前にスリープ防止中だった場合のみ、タイマーや指定時刻を引き継いでスリープ防止が再開されます。"
          }
        }
      }
    },
    "resume.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ防止の再開"
          }
        }
      }
    },
    "resume.option.app" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ後のみ"
