            "value" : "パスをコピー"
          }
        }
      }
    },
    "cli.path.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use the capsaicin command in Terminal, add this path to your PATH, or create a symbolic link or alias to it (for example: ln -s \"path\" ~/.local/bin/capsaicin)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルでcapsaicinコマンドを使うには、このパスを通すか、このパスへのシンボリックリンクやエイリアスを作成してください（例：ln -s \"パス\" ~/.local/bin/capsaicin）。"
          }
        }
      }
    },
    "cli.path.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command location"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドの場所"
          }
        }
      }
    },
