    "hotkey.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you turn sleep prevention on or off with a keyboard shortcut. When you turn it on with the hotkey, the “Turn Off Automatically” conditions in Sleep settings apply."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キー操作でスリープ防止の切り替えができるようになります。ホットキーでスリープ防止をオンにしたときは、設定の「スリープ」の「自動でオフにする条件」が適用されます。"
          }
        }
      }
    },
    "hotkey.label" : {
      "extractionState" : "manual",
