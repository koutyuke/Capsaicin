{
  "sourceLanguage" : "ja",
  "strings" : {
    "cli.group.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Line"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドライン"
          }
        }
      }
    },
    "cli.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you turn sleep prevention on or off and check its status from Terminal. When this is off, the command shows an error and can’t control Capsaicin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルからスリープ防止の切り替え操作や現在の状態を取得することができます。オフにするとコマンドはエラーを表示し、コマンドラインからの操作ができなくなります。"
          }
        }
      }
    },
    "cli.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control from CLI"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLIからの操作を許可"
          }
        }
      }
    },
    "cli.path.copied.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Path copied"
          }
        },
        "ja" : {
