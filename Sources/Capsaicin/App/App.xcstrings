      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing the update will turn sleep prevention off and restart Capsaicin. It won't turn back on automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートをインストールするとスリープ防止がオフになり、Capsaicinが再起動します。再起動しても自動ではオンに戻りません。"
          }
        }
