        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some sleep or LED changes are still in effect. Capsaicin will undo them the next time it opens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープまたは LED の制御が残っています。次に Capsaicin を起動したときに戻し直します。"
